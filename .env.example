# Only sample values belong in this file. Never commit the real .env file.
NODE_ENV=development
PORT=4173

# Replace the username, password, host and database name for each installation.
DATABASE_URL=postgres://diaco:CHANGE_ME@127.0.0.1:5432/diaco
DATABASE_SSL=false

# Keep these false for the current HTTP-based local network installation.
TRUST_PROXY=false
COOKIE_SECURE=false

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
UPLOADS_DIR=data/uploads
BACKUPS_DIR=data/backups

# Use a long, private value in the real .env when encrypted backups are enabled.
BACKUP_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
